# Local MySQL configuration for Alpha Deutsch.
# Copy to .env.local for development. Never commit real credentials.
# Database: alphadeutsch (imported locally from git-ignored sql-db/alphad.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=alphadeutsch_app
DB_PASSWORD=change-me
DB_NAME=alphadeutsch
# Public HTTPS backend used by the packaged Android WebView for read-only
# course APIs. Leave empty for local web development (same-origin /api/*).
# Example: NEXT_PUBLIC_API_BASE_URL=https://alphadeutsch.example
NEXT_PUBLIC_API_BASE_URL=
