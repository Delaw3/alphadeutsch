# Local MySQL configuration for Alpha Deutsch.
# Copy to .env.local for development. Never commit real credentials.
# Database: alphadeutsch (imported locally from git-ignored sql-db/alphad.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=alphadeutsch_app
DB_PASSWORD=change-me
DB_NAME=alphadeutsch
# Public HTTPS backend used by the packaged Android WebView for read-only
# course APIs. Leave empty for local web development (same-origin /api/*).
# Example: NEXT_PUBLIC_API_BASE_URL=https://alphadeutsch.example
NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# E-mail delivery (Phase 2A).
# Local development / tests: keep AUTH_EMAIL_PROVIDER=dev (in-memory outbox).
# Production: set AUTH_EMAIL_PROVIDER=smtp and provide the SMTP_* values in the
# hosting environment. Never commit real credentials.
# WhoGoHost contract: port 465 uses implicit TLS (SMTP_SECURE=true); port 587
# uses STARTTLS (SMTP_SECURE=false). Port 25 is rejected.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# From address. Use the authenticated mailbox. SMTP_FROM wins when both are
# set; EMAIL_FROM is still accepted as a legacy alias.
SMTP_FROM=
SMTP_FROM_NAME=Alpha Deutsch
AUTH_EMAIL_PROVIDER=dev

# ---------------------------------------------------------------------------
# Public origin of this app.
# Used for server-side course fetches and to build the absolute logo URL in
# verification e-mails. Example: https://alphadeutsch.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# Absolute URL of the logo shown at the top of the verification e-mail.
# Defaults to ${NEXT_PUBLIC_SITE_URL}/brand/logo-256.png. When neither is set
# the e-mail falls back to a text wordmark instead of a broken image.
# ---------------------------------------------------------------------------
EMAIL_LOGO_URL=

# ---------------------------------------------------------------------------
# OTP challenge hashing (Phase 2B).
# Required when issuing or verifying e-mail codes. Supply exactly 64 lowercase
# or uppercase hexadecimal characters (for example: openssl rand -hex 32) in
# the hosting environment. Never commit a real pepper.
#
# The opt-in MySQL integration tests (Phase 2B.3) also require a valid
# 64-character hexadecimal pepper. Run them only with:
#   npm run test:auth:integration -- --allow-local-db
# The runner supplies test-only environment overrides, refuses non-loopback
# hosts and any database other than alphadeutsch, uses @example.invalid
# mailboxes, never sends e-mail, and removes only the rows it created.
# ---------------------------------------------------------------------------
AUTH_CODE_PEPPER=

# ---------------------------------------------------------------------------
# E-mail verification gate.
# When "true", /api/auth/signin answers 403 (code "email-not-verified") for an
# account whose address is not confirmed yet; the app then shows the
# /verify-email screen. Keep "false" until existing accounts are verified.
# ---------------------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFY=false

# ---------------------------------------------------------------------------
# Local-only testing helper.
# The dev outbox (AUTH_EMAIL_PROVIDER=dev) keeps codes in memory, so set this to
# "true" to print the six-digit code in the dev server log while testing the
# /verify-email screen. Never set it in production: the dev adapter refuses to
# deliver there and this flag is ignored when NODE_ENV=production.
# ---------------------------------------------------------------------------
AUTH_DEV_EXPOSE_CODES=false
